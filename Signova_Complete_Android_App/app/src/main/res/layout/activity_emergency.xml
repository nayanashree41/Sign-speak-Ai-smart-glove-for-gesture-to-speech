<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#08090D">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/emergency_silhouette" android:contentDescription="Emergency hand" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_emergency_overlay" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="26dp">
        <Space android:layout_width="1dp" android:layout_height="120dp" />
        <ImageView android:layout_width="90dp" android:layout_height="65dp" android:src="@drawable/signova_mark" android:adjustViewBounds="true" android:contentDescription="Signova logo" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Emergency Communication" android:textColor="@color/white" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Speak a clear assistance message immediately." android:textColor="#D7CFD8" android:textSize="16sp" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <Button android:id="@+id/btnEmergencySpeak" android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/bg_primary_button" android:text="🔊  Please help me" android:textAllCaps="false" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" android:backgroundTint="@null" />
        <Button android:id="@+id/btnEmergencyBack" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_chip" android:text="Back" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@null" />
        <Space android:layout_width="1dp" android:layout_height="28dp" />
    </LinearLayout>
</FrameLayout>
