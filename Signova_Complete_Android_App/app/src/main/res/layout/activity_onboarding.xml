<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/signova_light_bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.42"
        android:scaleType="centerCrop"
        android:src="@drawable/gesture_pattern"
        android:contentDescription="Gesture pattern" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_onboarding_scrim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="640dp"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="20dp"
            android:paddingEnd="30dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Skip"
                android:textColor="#34303A"
                android:textSize="15sp" />

            <Space android:layout_width="1dp" android:layout_height="60dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turn\nGestures\ninto"
                android:textColor="#111117"
                android:textSize="43sp"
                android:lineSpacingExtra="-4dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Words"
                android:textColor="@color/signova_purple"
                android:textSize="43sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="290dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Signova helps bridge conversations with gesture-to-speech AI."
                android:textColor="#544B5C"
                android:textSize="17sp"
                android:lineSpacingExtra="3dp" />

            <Space android:layout_width="1dp" android:layout_height="30dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="7dp">
                <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_round_lilac" android:gravity="center" android:text="▣" android:textColor="@color/signova_purple" android:textSize="22sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Real-time\ngesture recognition" android:textColor="#3F3946" android:textSize="16sp" android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="7dp">
                <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_round_lilac" android:gravity="center" android:text=")))" android:textColor="@color/signova_purple" android:textSize="18sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Convert to clear\nand natural speech" android:textColor="#3F3946" android:textSize="16sp" android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="7dp">
                <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_round_lilac" android:gravity="center" android:text="●●" android:textColor="@color/signova_purple" android:textSize="17sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="More inclusive\nconversations" android:textColor="#3F3946" android:textSize="16sp" android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:orientation="horizontal">
                <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/bg_round_red" />
                <Space android:layout_width="9dp" android:layout_height="1dp" />
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_round_lilac" />
                <Space android:layout_width="9dp" android:layout_height="1dp" />
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_round_lilac" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGetStarted"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_black_button"
                android:text="Get Started     ›"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" android:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
